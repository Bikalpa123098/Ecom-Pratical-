# ---------------------------------------------------------------------------
# Bikalpa Shoes — environment
#
# Copy to `.env` and fill in. Never commit `.env`.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# Prisma's MongoDB connector requires a replica set, even single-node.
# The connection string must therefore name the replica set.
#
# Local native MongoDB (replica set "rs0"):
DATABASE_URL="mongodb://127.0.0.1:27017/bikalpa?replicaSet=rs0&directConnection=true"
#
# Docker Compose (see docker-compose.yml):
# DATABASE_URL="mongodb://127.0.0.1:27017/bikalpa?replicaSet=rs0&directConnection=true"
#
# Atlas:
# DATABASE_URL="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/bikalpa?retryWrites=true&w=majority"
#
# NOTE: do NOT reuse a database name that another app already owns.

# --- App --------------------------------------------------------------------
# Public origin of this deployment. eSewa success_url/failure_url are derived
# from this on the server. Must match the origin eSewa can reach.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Auth -------------------------------------------------------------------
# better-auth signing key. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be at least 16 characters.
BETTER_AUTH_SECRET="replace-me-with-a-long-random-string"
BETTER_AUTH_URL="http://localhost:3000"

# --- eSewa ePay -------------------------------------------------------------
# "test"      -> rc-epay / rc.esewa.com.np gateways, product code EPAYTEST
# "production"-> epay.esewa.com.np gateways
#
# Do not switch a live deployment from test to production without also rotating
# ESEWA_SECRET_KEY and ESEWA_MERCHANT_CODE. In production the merchant code
# must not be EPAYTEST, and the code refuses to start if it is.
ESEWA_MODE="test"

# The merchant code issued by eSewa.
ESEWA_MERCHANT_CODE="EPAYTEST"

# The HMAC-SHA256 signing key issued by eSewa. Server-side only — never expose
# to the browser, never commit. Checkout is refused if this is empty.
#
# eSewa does not publish the UAT signing key; request it from eSewa merchant
# support. Until then, real payments cannot be completed in this environment.
# For UAT/test mode, eSewa's published signing key is:
ESEWA_SECRET_KEY="8gBm/:&EnhH.1/q("

# Optional. Leave empty to use the documented endpoints for ESEWA_MODE.
# ESEWA_FORM_URL="https://epay.esewa.com.np/api/epay/main/v2/form"
# ESEWA_STATUS_URL="https://esewa.com.np/api/epay/transaction/status/"

# --- Store pricing ----------------------------------------------------------
# Delivery charges are in RUPEES and are converted to paisa when an order is
# totalled. Everything else in this app is in paisa.
DELIVERY_CHARGE_INSIDE_VALLEY_RUPEES="80"
DELIVERY_CHARGE_OUTSIDE_VALLEY_RUPEES="150"

# In PAISA, because it is compared directly against a paisa subtotal.
# 500000 paisa = Rs. 5,000. Set to 0 to disable free delivery.
FREE_DELIVERY_THRESHOLD_PAISA="500000"

# Sales tax as basis points of the subtotal. 1300 = 13%. 0 disables tax.
TAX_RATE_BPS="0"

# --- Seed -------------------------------------------------------------------
# Credentials for the administrator created by `npm run seed`.
SEED_ADMIN_EMAIL="admin@bikalpa.com"
SEED_ADMIN_PASSWORD="change-this-before-seeding"

# --- Optional ----------------------------------------------------------------
# Shown in the footer.
# NEXT_PUBLIC_SHOP_PHONE="+977 980-1234567"
